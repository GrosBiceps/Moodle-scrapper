{
  "manifest_version": 3,
  "name": "Course Downloader for Moodle™",
  "short_name": "Course Downloader",
  "version": "4.0.0",
  "description": "Télécharge et synchronise les fichiers de tes cours Moodle dans le dossier de ton choix. Sync incrémentale, index hors-ligne.",
  "homepage_url": "https://github.com/GrosBiceps/Moodle-scrapper",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "*://*/*"
  ]
}
